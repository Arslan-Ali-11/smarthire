# =====================================================================
# SmartHire - Environment Configuration Example
# Copy this file to .env and fill in your values
# =====================================================================

# Flask Core Configuration
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (Defaults to local SQLite instance)
# For PostgreSQL (e.g. Render/Heroku): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///instance/smarthire.db

# AI API Keys (Optional - Intelligent Heuristic Engine runs if omitted)
# Google Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Free tier): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Email SMTP Notifications (Optional - Graceful simulated fallback if omitted)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER="SmartHire <noreply@smarthire.local>"
MAIL_SUPPRESS_SEND=False
